# Store .obj directly in Git (both models are <100 MiB) so clones/ZIPs work without Git LFS
*.obj binary
*.fbx filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text

# Source code & Unity text-serialized assets
*.cs text eol=lf
*.shader text eol=lf
*.hlsl text eol=lf
*.cginc text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.mat text eol=lf
*.asset text eol=lf
*.meta text eol=lf

# Standard binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.tga binary
*.exr binary
*.wav binary
*.mp3 binary
*.ogg binary
